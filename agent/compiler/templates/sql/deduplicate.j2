-- Step: {{ step_id }} ({{ description }})
{% set target_table = staging_table | default('[dbo].[' ~ dataset_name ~ '_Staging]') %}
WITH [DedupCTE] AS (
    SELECT *,
           ROW_NUMBER() OVER (
               {% if columns %}PARTITION BY {% for col in columns %}[{{ col }}]{% if not loop.last %}, {% endif %}{% endfor %}{% endif %}
               ORDER BY {{ survivor_order | default(order_by_clause) | default("[" ~ columns[0] ~ "] ASC" if columns else "(SELECT 1)") }}
           ) AS [__duplicate_rank]
    FROM {{ target_table }}
)
{% if never_drop_rows %}
-- Flag duplicate rows to Rejection_Log (retained due to never_drop_rows policy)
INSERT INTO [ETL_REJECT].[Rejection_Log] ([PipelineId], [RunId], [DatasetName], [IssueId], [StepId], [ColumnName], [Reason], [Disposition], [OriginalValue], [RejectedRowData])
SELECT @PipelineId, @RunId, '{{ dataset_name }}', '{{ issue_id | default("") }}', '{{ step_id }}', '{{ columns | join(", ") }}', 'Duplicate record (retained due to never_drop_rows policy)', 'FLAG', NULL, (SELECT * FROM [DedupCTE] c WHERE c.[__duplicate_rank] > 1 FOR JSON PATH);
{% else %}
-- Quarantine duplicate rows to Rejection_Log and delete
INSERT INTO [ETL_REJECT].[Rejection_Log] ([PipelineId], [RunId], [DatasetName], [IssueId], [StepId], [ColumnName], [Reason], [Disposition], [OriginalValue], [RejectedRowData])
SELECT @PipelineId, @RunId, '{{ dataset_name }}', '{{ issue_id | default("") }}', '{{ step_id }}', '{{ columns | join(", ") }}', 'Duplicate record', 'QUARANTINE', NULL, (SELECT * FROM [DedupCTE] c WHERE c.[__duplicate_rank] > 1 FOR JSON PATH);

DELETE FROM [DedupCTE] WHERE [__duplicate_rank] > 1;
{% endif %}


