-- Step: {{ step_id }} ({{ description }})
WITH [DedupCTE] AS (
    SELECT *,
           ROW_NUMBER() OVER (
               PARTITION BY {% for col in columns %}[{{ col }}]{% if not loop.last %}, {% endif %}{% endfor %}
               ORDER BY {{ survivor_order | default(order_by_clause) | default("[" ~ columns[0] ~ "] ASC" if columns else "(SELECT 1)") }}
           ) AS [__duplicate_rank]
    FROM [dbo].[{{ dataset_name }}_Staging]
)
{% if never_drop_rows %}
-- Quarantine duplicate rows to Rejection_Log
INSERT INTO [ETL_REJECT].[Rejection_Log] ([PipelineId], [DatasetName], [Reason], [RejectedRowData])
SELECT '{{ pipeline_id | default("adhoc") }}', '{{ dataset_name }}', 'Duplicate record', (SELECT * FROM [DedupCTE] c WHERE c.[__duplicate_rank] > 1 FOR JSON PATH);

DELETE FROM [DedupCTE] WHERE [__duplicate_rank] > 1;
{% else %}
DELETE FROM [DedupCTE] WHERE [__duplicate_rank] > 1;
{% endif %}
