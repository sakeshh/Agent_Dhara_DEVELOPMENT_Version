-- Step: {{ step_id }} ({{ description }})
{% set target_table = staging_table | default('[dbo].[' ~ dataset_name ~ '_Staging]') %}
UPDATE {{ target_table }}
SET
{% for col in columns %}
    [{{ col }}] = CASE 
        WHEN [{{ col }}] IN ({% for s in sentinel_values | default(['NA', 'N/A', 'NULL', 'None', '-999', '?', '-']) %}N'{{ s | replace("'", "''") }}'{% if not loop.last %}, {% endif %}{% endfor %}) THEN NULL 
        ELSE [{{ col }}] 
    END{% if not loop.last %},{% endif %}
{% endfor %}
;

