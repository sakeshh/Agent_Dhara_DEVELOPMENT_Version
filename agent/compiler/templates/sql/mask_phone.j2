-- Step: {{ step_id }} ({{ description }})
-- Strategy: Mask Phone PII on [{{ dataset_name }}]
{% set target_table = staging_table | default('[dbo].[' ~ dataset_name ~ '_Staging]') %}

{% for col in columns %}
UPDATE {{ target_table }}
SET [{{ col }}] = CASE 
    WHEN [{{ col }}] IS NULL THEN NULL
    WHEN [{{ col }}] LIKE '%*%' THEN [{{ col }}] -- Idempotent: already masked
    WHEN LEN(RTRIM(LTRIM([{{ col }}]))) <= 4 THEN REPLICATE('*', LEN(RTRIM(LTRIM([{{ col }}]))))
    ELSE REPLICATE('*', LEN(RTRIM(LTRIM([{{ col }}]))) - 4) + RIGHT(RTRIM(LTRIM([{{ col }}])), 4)
END
WHERE [{{ col }}] IS NOT NULL
  AND [{{ col }}] NOT LIKE '%*%';
{% endfor %}
