-- Step: {{ step_id }} ({{ description }})
UPDATE [dbo].[{{ dataset_name }}_Staging]
SET
{% for col in columns %}
    [{{ col }}] = CASE
        {% if min_value is defined %}WHEN [{{ col }}] < {{ min_value }} THEN {{ min_value }}{% endif %}
        {% if max_value is defined %}WHEN [{{ col }}] > {{ max_value }} THEN {{ max_value }}{% endif %}
        ELSE [{{ col }}]
    END{% if not loop.last %},{% endif %}
{% endfor %}
;
