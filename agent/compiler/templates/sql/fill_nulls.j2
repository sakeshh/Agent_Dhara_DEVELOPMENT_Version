-- Step: {{ step_id }} ({{ description }})
{% set target_table = staging_table | default('[dbo].[' ~ dataset_name ~ '_Staging]') %}
UPDATE {{ target_table }}
SET
{% for col in columns %}
{% if is_numeric or data_type in ['int', 'bigint', 'smallint', 'tinyint', 'decimal', 'numeric', 'float', 'real', 'money', 'smallmoney'] %}
    [{{ col }}] = COALESCE([{{ col }}], {{ fill_value if (fill_value is defined and fill_value is not none and fill_value != '') else 0 }}){% if not loop.last %},{% endif %}
{% else %}
    [{{ col }}] = COALESCE([{{ col }}], {{ fill_value | default('') | render_literal }}){% if not loop.last %},{% endif %}
{% endif %}
{% endfor %}
WHERE
{% for col in columns %}
    [{{ col }}] IS NULL{% if not loop.last %} OR {% endif %}
{% endfor %}
;

