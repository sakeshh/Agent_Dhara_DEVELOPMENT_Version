-- Step: {{ step_id }} ({{ description }})
{% set target_table = staging_table | default('[dbo].[' ~ dataset_name ~ '_Staging]') %}
UPDATE {{ target_table }}
SET
{% for col in columns %}
    [{{ col }}] = CASE 
        WHEN [{{ col }}] IS NULL THEN NULL
        WHEN LEN([{{ col }}]) >= {{ length }} THEN [{{ col }}]
        {% if side == 'right' %}
        ELSE CONCAT([{{ col }}], REPLICATE({{ fill_character | render_literal }}, {{ length }} - LEN([{{ col }}])))
        {% else %}
        ELSE CONCAT(REPLICATE({{ fill_character | render_literal }}, {{ length }} - LEN([{{ col }}])), [{{ col }}])
        {% endif %}
    END{% if not loop.last %},{% endif %}
{% endfor %}
;

