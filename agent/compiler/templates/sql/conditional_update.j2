-- Step: {{ step_id }} ({{ description }})
{% set target_table = staging_table | default('[dbo].[' ~ dataset_name ~ '_Staging]') %}
{% set disp = disposition | default('CORRECT') | upper %}
{% if disp == 'REJECT' and not never_drop_rows %}
-- 1. Quarantine & Reject rows matching condition atomically
IF OBJECT_ID('tempdb..#Rejected_{{ step_id | replace("-", "_") }}') IS NOT NULL DROP TABLE #Rejected_{{ step_id | replace("-", "_") }};

SELECT *
INTO #Rejected_{{ step_id | replace("-", "_") }}
FROM {{ target_table }} s
WHERE {{ sql_condition }};

IF EXISTS (SELECT 1 FROM #Rejected_{{ step_id | replace("-", "_") }})
BEGIN
    INSERT INTO [ETL_REJECT].[Rejection_Log] (
        [PipelineId], [RunId], [DatasetName], [IssueId], [StepId], [ColumnName], [Reason], [Disposition], [OriginalValue], [RejectedRowData]
    )
    SELECT 
        @PipelineId,
        @RunId,
        '{{ dataset_name }}',
        '{{ issue_id | default("") }}',
        '{{ step_id }}',
        '{{ columns | join(", ") }}',
        'Conditional rule violation: {{ description | default(sql_condition) }}',
        'REJECT',
        CAST(r.[{{ columns[0] }}] AS NVARCHAR(MAX)),
        (SELECT r.* FOR JSON PATH, WITHOUT_ARRAY_WRAPPER)
    FROM #Rejected_{{ step_id | replace("-", "_") }} r;

    DELETE s
    FROM {{ target_table }} s
    INNER JOIN #Rejected_{{ step_id | replace("-", "_") }} r
        ON r.[_DharaStagingRowId] = s.[_DharaStagingRowId];
END;

IF OBJECT_ID('tempdb..#Rejected_{{ step_id | replace("-", "_") }}') IS NOT NULL DROP TABLE #Rejected_{{ step_id | replace("-", "_") }};

{% elif disp == 'FLAG' %}
-- FLAG: Log rows that violate the condition to ETL_REJECT.Rejection_Log.
-- The source row is NOT mutated — the key column retains its original value (including NULL).
-- The caller decides how to handle the flagged rows after review.
IF EXISTS (SELECT 1 FROM {{ target_table }} WHERE {{ sql_condition }})
BEGIN
    INSERT INTO [ETL_REJECT].[Rejection_Log] (
        [PipelineId], [RunId], [DatasetName], [IssueId], [StepId], [ColumnName], [Reason], [Disposition], [OriginalValue], [RejectedRowData]
    )
    SELECT
        @PipelineId,
        @RunId,
        N'{{ dataset_name }}',
        N'{{ issue_id | default("") }}',
        N'{{ step_id }}',
        N'{{ columns | join(", ") }}',
        N'{{ description | default(sql_condition) }}',
        N'FLAG',
        CAST(s.[{{ columns[0] }}] AS NVARCHAR(MAX)),
        (SELECT s.* FOR JSON PATH, WITHOUT_ARRAY_WRAPPER)
    FROM {{ target_table }} AS s
    WHERE {{ sql_condition }};
END;
-- Source rows are left UNCHANGED — no SET or UPDATE is emitted for FLAG disposition.

{% else %}
UPDATE {{ target_table }}
SET
{% for col in columns %}
    [{{ col }}] = CASE 
        WHEN {{ sql_condition }} THEN {{ rendered_new_value }}
        {% if rendered_else_value is not none and rendered_else_value != '' %}
        ELSE {{ rendered_else_value }}
        {% else %}
        ELSE [{{ col }}]
        {% endif %}
    END{% if not loop.last %},{% endif %}
{% endfor %}
;
{% endif %}

