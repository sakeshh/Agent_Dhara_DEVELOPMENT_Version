-- Step: {{ step_id }} ({{ description }})
{% set target_table = staging_table | default('[dbo].[' ~ dataset_name ~ '_Staging]') %}
UPDATE {{ target_table }}
SET
{% for col in columns %}
    [{{ col }}] = CASE 
        WHEN [{{ col }}] IS NULL THEN NULL
        {% if only_if_missing %}
        WHEN [{{ col }}] LIKE {{ (prefix ~ '%') | render_literal }} THEN [{{ col }}]
        {% endif %}
        ELSE CONCAT({{ prefix | render_literal }}, [{{ col }}])
    END{% if not loop.last %},{% endif %}
{% endfor %}
;

