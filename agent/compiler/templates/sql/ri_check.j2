-- Step: {{ step_id }} ({{ description }})
-- Referential Integrity check: [{{ dataset_name }}].[{{ child_key }}] -> [{{ parent_dataset }}].[{{ parent_key }}]
{% if parent_dataset and parent_key and child_key %}
INSERT INTO [ETL_REJECT].[Rejection_Log] ([PipelineId], [RunId], [DatasetName], [IssueId], [StepId], [ColumnName], [Reason], [Disposition], [OriginalValue], [RejectedRowData])
SELECT @PipelineId, @RunId, '{{ dataset_name }}', '{{ issue_id | default("") }}', '{{ step_id }}', '{{ child_key }}', 'Orphan foreign key in {{ child_key }}', 'QUARANTINE', NULL, (
    SELECT c.*
    FROM [dbo].[{{ dataset_name }}_Staging] c
    LEFT JOIN [dbo].[{{ parent_dataset }}] p ON c.[{{ child_key }}] = p.[{{ parent_key }}]
    WHERE p.[{{ parent_key }}] IS NULL AND c.[{{ child_key }}] IS NOT NULL
    FOR JSON PATH
);

{% if not never_drop_rows %}
DELETE c
FROM [dbo].[{{ dataset_name }}_Staging] c
LEFT JOIN [dbo].[{{ parent_dataset }}] p ON c.[{{ child_key }}] = p.[{{ parent_key }}]
WHERE p.[{{ parent_key }}] IS NULL AND c.[{{ child_key }}] IS NOT NULL;
{% endif %}
{% endif %}
